# MedConnect Environment Configuration Example
# Copy this file to '.env' in local development: cp .env.example .env

# Flask Session Security Key
# In production, generate a secure secret key (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Server Binding Configuration (Optional)
PORT=5000
HOST=127.0.0.1

# Flask Runtime Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

