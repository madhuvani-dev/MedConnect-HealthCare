# MedConnect Environment Configuration Example
# Copy this file to '.env' for local development: cp .env.example .env

# Mandatory Security & Configuration
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Server Settings
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# Note on Notifications:
# Real-time in-app notifications (badges, dropdowns, unread counters) work
# out of the box using SQLite and do not require external credentials.
# SMS notifications and Web Push alerts are deferred to future scope.
