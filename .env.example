# MedConnect Environment Configuration Example
# Copy this file to '.env' for local development: cp .env.example .env

SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# SMS Notification Provider Configuration
# Supported providers: twilio, fast2sms, msg91
SMS_PROVIDER=twilio
# For Twilio: Account SID (starts with AC...) | For Fast2SMS: API Authorization Key | For MSG91: Authkey
SMS_API_KEY=
# For Twilio: Auth Token | For others: Leave empty if not required
SMS_API_SECRET=
# For Twilio: Sender Phone Number (+1...) or Messaging Service SID | For Fast2SMS/MSG91: Sender ID (e.g., MEDCON)
SMS_SENDER_ID=
